POSTGRES_USER=ift
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_LOCAL_PASSWORD
POSTGRES_DB=ift_access
POSTGRES_PORT=55432
DATABASE_URL=postgresql+psycopg://ift:REPLACE_WITH_GENERATED_LOCAL_PASSWORD@127.0.0.1:55432/ift_access
ENVIRONMENT=development
# Development HTTP only. Set false and use HTTPS outside local development.
ALLOW_INSECURE_DEV_COOKIES=true
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=backend/var/uploads
UPLOAD_LIMIT=5242880
SESSION_HOURS=12
CONTROLLER_MODE=SIMULATED
SIMULATION_CONTROLS_ENABLED=false
JOBS_ENABLED=true
# Read-only preflight: run backend/scripts/configure_hikvision.py locally.
# Select HIKVISION_READ_ONLY to block all controller writes.
# HIKVISION_CONTROLLED additionally requires an authenticated per-controller
# test scope. Never enables the old backlog, remote unlock or fake enrolment.
# Current DS-K2802 scope activation is blocked by incomplete template capacity
# evidence; see docs/hikvision-capabilities.md before changing mode.
HIKVISION_HOST=10.10.20.8
HIKVISION_PORT=8000
HIKVISION_USERNAME=
HIKVISION_PASSWORD=
HIKVISION_CONNECT_TIMEOUT=3
HIKVISION_SDK_DIR=EN-HCNetSDKV6.1.9.4_build20220412_linux64
# Host bridge; the optional Compose override selects the container-built bridge.
HIKVISION_BRIDGE_PATH=backend/var/hikvision/ift-hikvision
HIKVISION_PROCESS_TIMEOUT=40
HIKVISION_INITIAL_MINUTES=60
HIKVISION_HISTORY_WINDOW_MINUTES=15
HIKVISION_EVENT_LIMIT=1000
HIKVISION_CONTROLLER_ID=controller-1
