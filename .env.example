POSTGRES_USER=ift
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_LOCAL_PASSWORD
POSTGRES_DB=ift_access
POSTGRES_PORT=55432
DATABASE_URL=postgresql+psycopg://ift:REPLACE_WITH_GENERATED_LOCAL_PASSWORD@127.0.0.1:55432/ift_access
ENVIRONMENT=development
# Development HTTP only. Set false and use HTTPS outside local development.
ALLOW_INSECURE_DEV_COOKIES=true
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=backend/var/uploads
UPLOAD_LIMIT=5242880
SESSION_HOURS=12
CONTROLLER_MODE=SIMULATED
SIMULATION_CONTROLS_ENABLED=false
JOBS_ENABLED=true
